{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "bash ./scripts/hooks/copilot/session-init.sh",
        "powershell": "if (Test-Path .venv\\Scripts\\pythonw.exe) { & .\\.venv\\Scripts\\pythonw.exe scripts\\hooks\\copilot\\hook_dispatch.py session-init } else { '{}' }; exit 0",
        "command": "bash ./scripts/hooks/copilot/session-init.sh",
        "windows": ".venv\\Scripts\\pythonw.exe scripts\\hooks\\copilot\\hook_dispatch.py session-init",
        "cwd": ".",
        "timeoutSec": 15,
        "timeout": 15
      }
    ],
    "UserPromptSubmit": [
