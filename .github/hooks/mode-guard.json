{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "bash ./scripts/hooks/copilot/mode-guard.sh",
        "powershell": "if (Test-Path .venv\\Scripts\\pythonw.exe) { & .\\.venv\\Scripts\\pythonw.exe scripts\\hooks\\copilot\\hook_dispatch.py mode-guard } else { '{}' }; exit 0",
        "command": "bash ./scripts/hooks/copilot/mode-guard.sh",
        "windows": ".venv\\Scripts\\pythonw.exe scripts\\hooks\\copilot\\hook_dispatch.py mode-guard",
        "cwd": ".",
        "timeoutSec": 10,
        "timeout": 10
      }
    ]
  }
}
