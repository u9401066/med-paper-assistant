{
  "name": "medpaper-assistant",
  "displayName": "MedPaper Assistant",
  "description": "Compact-first MCP research workspace with source-material intake for manuscript and library-wiki workflows in VS Code",
  "version": "1.0.3",
  "publisher": "u9401066",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0B1F35",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/u9401066/med-paper-assistant"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Data Science",
    "Education"
  ],
  "keywords": [
    "medical",
    "paper",
    "writing",
    "pubmed",
    "research",
    "source-materials",
    "asset-aware",
    "mcp",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "mdpaper",
        "label": "MedPaper Assistant MCP Server"
      }
    ],
    "chatParticipants": [
      {
        "id": "medpaper.assistant",
        "name": "mdpaper",
        "fullName": "MedPaper Assistant",
        "description": "協助文獻探索、LLM wiki 整理、研究概念驗證、稿件撰寫與匯出",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "搜尋 PubMed 與延伸研究"
          },
          {
            "name": "draft",
            "description": "撰寫與修訂論文章節"
          },
          {
            "name": "concept",
            "description": "發展並驗證研究概念"
          },
          {
            "name": "project",
            "description": "管理 manuscript / library-wiki 專案"
          },
          {
            "name": "format",
            "description": "匯出 Word 與投稿文件"
          },
          {
            "name": "autopaper",
            "description": "全自動寫論文（13 main gate checkpoints + Phase 2.1 sub-gate + 79 Hooks）"
          },
          {
            "name": "drawio",
            "description": "📐 Draw.io 圖表與流程圖（Webview + MCP）"
          },
          {
            "name": "analysis",
            "description": "資料分析、Table 1 與圖表"
          },
          {
            "name": "strategy",
            "description": "搜尋策略與工作流設定"
          },
          {
            "name": "help",
            "description": "顯示 @mdpaper 指令與工作流"
          }
        ],
        "disambiguation": [
          {
            "category": "medical-paper-writing",
            "description": "User wants help with medical paper writing, literature review, or research concept development",
            "examples": [
              "幫我找 remimazolam 相關論文",
              "寫一篇關於 ECMO 的 introduction",
              "驗證我的研究 novelty",
              "搜尋 PubMed",
              "全自動寫論文",
              "一鍵寫論文",
              "Help me respond to reviewer comments"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "mdpaper.showStatus",
        "title": "Show MedPaper Status",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.autoPaper",
        "title": "Auto Paper - 全自動寫論文",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.setupWorkspace",
        "title": "Setup Workspace - 設定 Skills/Prompts/Docs/Instructions/Templates",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.openLlmWikiGuide",
        "title": "Open LLM Wiki Guide - 開啟 LLM Wiki 使用指南",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.showGraphDefault",
        "title": "Show Foam Graph: Default",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.showGraphEvidence",
        "title": "Show Foam Graph: Evidence",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.showGraphWriting",
        "title": "Show Foam Graph: Writing",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.showGraphAssets",
        "title": "Show Foam Graph: Assets",
        "category": "MedPaper"
      },
      {
        "command": "mdpaper.showGraphReview",
        "title": "Show Foam Graph: Review",
        "category": "MedPaper"
      }
    ],
    "configuration": {
      "title": "MedPaper Assistant",
      "properties": {
        "mdpaper.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python executable. Leave empty to use bundled Python or system default."
        },
        "mdpaper.toolSurface": {
          "type": "string",
          "enum": [
            "compact",
            "full"
          ],
          "default": "compact",
          "description": "MedPaper MCP tool surface. Use full to expose advanced wiki/reference orchestration tools such as import_local_papers, ingest_web_source, ingest_markdown_source, resolve_reference_identity, and materialize_agent_wiki."
        }
      }
    },
    "chatSkills": [
      {
        "path": "./skills/literature-review/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.literature_review"
      },
      {
        "path": "./skills/concept-development/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.concept_development"
      },
      {
        "path": "./skills/concept-validation/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.concept_validation"
      },
      {
        "path": "./skills/parallel-search/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.parallel_search"
      },
      {
        "path": "./skills/project-management/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.project_management"
      },
      {
        "path": "./skills/draft-writing/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.draft_writing"
      },
      {
        "path": "./skills/reference-management/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.reference_management"
      },
      {
        "path": "./skills/word-export/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.word_export"
      },
      {
        "path": "./skills/auto-paper/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.auto_paper"
      },
      {
        "path": "./skills/academic-debate/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.academic_debate"
      },
      {
        "path": "./skills/idea-validation/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.idea_validation"
      },
      {
        "path": "./skills/manuscript-review/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.manuscript_review"
      },
      {
        "path": "./skills/submission-preparation/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.submission_preparation"
      },
      {
        "path": "./skills/git-precommit/SKILL.md",
        "when": "!mdpaper.workspaceAsset.skill.git_precommit"
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/concept-challenger.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.concept_challenger"
      },
      {
        "path": "./agents/domain-reviewer.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.domain_reviewer"
      },
      {
        "path": "./agents/literature-searcher.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.literature_searcher"
      },
      {
        "path": "./agents/meta-learner.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.meta_learner"
      },
      {
        "path": "./agents/methodology-reviewer.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.methodology_reviewer"
      },
      {
        "path": "./agents/paper-reviewer.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.paper_reviewer"
      },
      {
        "path": "./agents/reference-analyzer.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.reference_analyzer"
      },
      {
        "path": "./agents/review-orchestrator.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.review_orchestrator"
      },
      {
        "path": "./agents/statistics-reviewer.agent.md",
        "when": "!mdpaper.workspaceAsset.agent.statistics_reviewer"
      }
    ],
    "chatPromptFiles": [
      {
        "path": "./prompts/mdpaper.write-paper.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_write_paper"
      },
      {
        "path": "./prompts/mdpaper.literature-survey.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_literature_survey"
      },
      {
        "path": "./prompts/mdpaper.manuscript-revision.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_manuscript_revision"
      },
      {
        "path": "./prompts/mdpaper.search.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_search"
      },
      {
        "path": "./prompts/mdpaper.concept.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_concept"
      },
      {
        "path": "./prompts/mdpaper.draft.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_draft"
      },
      {
        "path": "./prompts/mdpaper.project.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_project"
      },
      {
        "path": "./prompts/mdpaper.format.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_format"
      },
      {
        "path": "./prompts/mdpaper.strategy.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_strategy"
      },
      {
        "path": "./prompts/mdpaper.analysis.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_analysis"
      },
      {
        "path": "./prompts/mdpaper.clarify.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_clarify"
      },
      {
        "path": "./prompts/mdpaper.help.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_help"
      },
      {
        "path": "./prompts/mdpaper.audit.prompt.md",
        "when": "!mdpaper.workspaceAsset.prompt.mdpaper_audit"
      }
    ]
  },
  "extensionDependencies": [],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle:check": "node ./scripts/bundle-assets.cjs check",
    "bundle:sync": "node ./scripts/bundle-assets.cjs sync",
    "bundle:sync-python": "node ./scripts/bundle-assets.cjs sync-python",
    "sync-assets:check": "npm run bundle:check",
    "pretest": "npm run compile",
    "test": "vitest run",
    "test:ci": "npm run compile && vitest run",
    "test:install-smoke": "node ./scripts/install-smoke.cjs",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "validate": "node ./scripts/run-validate-build.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "globals": "^17.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
